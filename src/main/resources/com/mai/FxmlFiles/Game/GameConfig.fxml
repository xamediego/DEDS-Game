<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<fx:root type="VBox" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1">
   <VBox alignment="CENTER" fillWidth="false" minHeight="350.0" minWidth="350.0" spacing="13.0">
      <VBox spacing="4.0">
         <HBox>
            <Label text="Recommended is between 50 and 100" />
         </HBox>
         <HBox alignment="CENTER" spacing="10.0">
            <VBox spacing="3.0">
               <Label text="Min Box Size" />
               <TextField fx:id="minSizeField" onMouseClicked="#move" onMouseEntered="#select" prefHeight="35.0" styleClass="inputField" />
            </VBox>
            <VBox HBox.hgrow="ALWAYS" />
            <VBox spacing="3.0">
               <Label text="Max Box Size" />
               <TextField fx:id="maxSizeField" onMouseClicked="#move" onMouseEntered="#select" prefHeight="35.0" styleClass="inputField" />
            </VBox>
         </HBox>
      </VBox>
      <VBox spacing="4.0">
         <HBox>
            <Label text="X Size and Y Size have to be &gt;= 7" />
         </HBox>
         <HBox alignment="CENTER" spacing="10.0">
            <VBox spacing="3.0">
               <Label text="X Size" />
               <TextField onMouseClicked="#move" onMouseEntered="#select" prefHeight="35.0" styleClass="inputField" fx:id="xSize" />
            </VBox>
            <VBox HBox.hgrow="ALWAYS" />
            <VBox spacing="3.0">
               <Label text="Y Size" />
               <TextField fx:id="ySize" onMouseClicked="#move" onMouseEntered="#select" prefHeight="35.0" styleClass="inputField" />
            </VBox>
         </HBox>
      </VBox>
      <VBox>
         <HBox alignment="CENTER" spacing="10.0">
            <VBox prefHeight="52.0" prefWidth="150.0" spacing="3.0" HBox.hgrow="ALWAYS">
               <Label text="New Game!" />
               <Button fx:id="startButton" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#startGame" onMouseClicked="#start" onMouseEntered="#select" prefHeight="35.0" prefWidth="100.0" styleClass="primaryButton" text="Start" />
            </VBox>
            <VBox HBox.hgrow="ALWAYS" />
            <VBox spacing="3.0" HBox.hgrow="ALWAYS">
               <Label text="Difficulty" />
               <ComboBox id="testChoice" fx:id="aITypes" onMouseClicked="#move" onMouseEntered="#select" prefHeight="35.0" prefWidth="150.0" />
            </VBox>
         </HBox>
         <HBox>
            <Label fx:id="gameInfo" />
         </HBox>
      </VBox>
      <HBox>
         <Button fx:id="startButtonNonAI" mnemonicParsing="false" onAction="#starNonAIGame" onMouseClicked="#start" onMouseEntered="#select" prefHeight="35.0" prefWidth="120.0" styleClass="tertiaryMenuButton" text="Start non AI Game" />
      </HBox>
   </VBox>
</fx:root>
